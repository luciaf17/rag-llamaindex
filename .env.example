# "openai" | "ollama" (local) | "gemini" (Google AI Studio) | "vertex" (Gemini en GCP)
PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_LLM=gpt-4o-mini
OPENAI_EMBED=text-embedding-3-small

# --- Ollama (antes: ollama pull llama3.1 && ollama pull nomic-embed-text) ---
OLLAMA_LLM=llama3.1
OLLAMA_EMBED=nomic-embed-text
OLLAMA_CONTEXT_WINDOW=8192

# --- Gemini con API key de Google AI Studio (PROVIDER=gemini) ---
GOOGLE_API_KEY=

# --- Gemini sobre Vertex AI en GCP (PROVIDER=vertex) ---
# Autenticación: gcloud auth application-default login
GCP_PROJECT=
GCP_LOCATION=us-central1

# Modelos Gemini (opcional: si quedan vacíos usa los default de la librería)
GEMINI_LLM=
GEMINI_EMBED=

# --- PostgreSQL con pgvector ---
# Local: docker compose up db (etapa 3) o cualquier Postgres con la extensión vector.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# Tabla (sin el prefijo data_ que agrega LlamaIndex). Vacío = rag_<PROVIDER>.
PG_TABLE=
# Dimensión del embedding. Vacío = se detecta con una llamada al modelo al arrancar.
EMBED_DIM=

# --- Parámetros del RAG ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=4
