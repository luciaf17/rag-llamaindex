# Lo que NO se sube a Cloud Build con "gcloud builds submit".
# Si este archivo existe, gcloud ignora el .gitignore, así que se repite todo.
.gcloudignore
.git/
.gitignore
# Secretos: nunca salen de tu máquina. En Cloud Run van por Secret Manager.
.env
.venv/
venv/
storage/
__pycache__/
*.pyc
# Los documentos se indexan en Supabase, no viajan en la imagen.
data/
tests/
pytest.ini
requirements-dev.txt
eval_set.json
docker-compose.yml
README.md
docs/
